\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u06a9\u0646\u06cc\u062f:\n\u2022 \u0628\u0647 \u0635\u0648\u0631\u062a \u062f\u0633\u062a\u06cc\n\u2022 \u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0627\u0632 \u0634\u0631\u062d \u0647\u0627\u06cc \u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u062f \u0645\u0639\u06cc\u0646 \u0627\u0646\u062a\u062e\u0627\u0628\u06cc\n\u2022 \u06a9\u067e\u06cc \u0627\u0632 \u0633\u0637\u0631 \u0628\u0627\u0644\u0627\n\u0634\u0645\u0627\u0631\u0647 \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0648 \u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u06af\u06cc\u0631\u06cc: \u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u06a9\u0647 \u0645\u0639\u06cc\u0646 \u062f\u0627\u0631\u0627\u06cc \u0648\u06cc\u0698\u06af\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0628\u0627\u0634\u062f \u0645\u0634\u0627\u0647\u062f\u0647 \u0634\u062f\u0647 \u0648 \u0627\u0645\u06a9\u0627\u0646 \u062b\u0628\u062a \u062f\u0627\u0631\u062f\n\u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u06a9\u0647 \u0645\u0639\u06cc\u0646 \u062f\u0627\u0631\u0627\u06cc \u0648\u06cc\u0698\u06af\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0648 \u0627\u062c\u0628\u0627\u0631\u06cc \u0628\u0627\u0634\u062f\u060c \u062a\u06a9\u0645\u06cc\u0644 \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062f \u0627\u062c\u0628\u0627\u0631\u06cc \u0627\u0633\u062a.\n\u0645\u0642\u062f\u0627\u0631: \u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u06a9\u0647 \u0645\u0639\u06cc\u0646 \u062f\u0627\u0631\u0627\u06cc \u0648\u06cc\u0698\u06af\u06cc \u0645\u0642\u062f\u0627\u0631\u06cc \u0628\u0627\u0634\u062f \u0645\u0634\u0627\u0647\u062f\u0647 \u0634\u062f\u0647 \u0648 \u0627\u0645\u06a9\u0627\u0646 \u062b\u0628\u062a \u062f\u0627\u0631\u062f.\u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u06a9\u0647 \u0645\u0639\u06cc\u0646 \u062f\u0627\u0631\u0627\u06cc \u0648\u06cc\u0698\u06af\u06cc \u0645\u0642\u062f\u0627\u0631\u06cc \u0648 \u0627\u062c\u0628\u0627\u0631\u06cc \u0628\u0627\u0634\u062f\u060c \u062a\u06a9\u0645\u06cc\u0644 \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062f \u0627\u062c\u0628\u0627\u0631\u06cc \u0627\u0633\u062a.\n\u062a\u0627\u0631\u06cc\u062e: \u062a\u0627\u0631\u06cc\u062e \u062b\u0628\u062a \u0631\u0633\u06cc\u062f \u062e\u0631\u06cc\u062f\u062f\u0627\u062e\u0644\u06cc \u062f\u0631 \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062f \u0627\u0646\u062a\u062e\u0627\u0628 \u0645\u06cc \u06af\u0631\u062f\u062f. \u0645\u0648\u062c\u0648\u062f\u06cc \u06a9\u0627\u0644\u0627\u06cc \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u0634\u062f\u0647 \u067e\u0633 \u0627\u0632 \u0627\u06cc\u0646 \u062a\u0627\u0631\u06cc\u062e \u062f\u0631 \u0627\u0646\u0628\u0627\u0631 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0645\u06cc \u06cc\u0627\u0628\u062f. \u0627\u0646\u062a\u062e\u0627\u0628 \u062a\u0627\u0631\u06cc\u062e \u062f\u0631 \u0631\u0633\u06cc\u062f \u062e\u0631\u06cc\u062f \u062f\u0627\u062e\u0644\u06cc \u0627\u062c\u0628\u0627\u0631\u06cc \u0627\u0633\u062a.\n  \u0634\u0645\u0627\u0631\u0647: \u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u06a9\u0647 \u0628\u0631\u0627\u06cc \u0627\u0633\u0646\u0627\u062f\u060c \u0631\u0648\u0634 \u0634\u0645\u0627\u0631\u0647 \u06af\u0630\u0627\u0631\u06cc \u062a\u0639\u0631\u06cc\u0641 \u0634\u062f\u0647 \u0628\u0627\u0634\u062f\u060c \u0634\u0645\u0627\u0631\u0647 \u0633\u0646\u062f \u0628\u0647 \u0635\u0648\u0631\u062a \u0627\u062a\u0648\u0645\u0627\u062a\u06cc\u06a9 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0647\u0645\u0627\u0646 \u0631\u0648\u0634 \u0645\u0642\u062f\u0627\u0631\u062f\u0647\u06cc \u0645\u06cc \u0634\u0648\u062f \u0648\u0644\u06cc \u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u06a9\u0647 \u0631\u0648\u0634 \u0634\u0645\u0627\u0631\u0647 \u06af\u0630\u0627\u0631\u06cc \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f\u060c \u0627\u06cc\u0646 \u0634\u0645\u0627\u0631\u0647 \u062a\u0648\u0633\u0637 \u0627\u0646\u0628\u0627\u0631\u062f\u0627\u0631 \u0628\u0647 \u0635\u0648\u0631\u062a \u062f\u0633\u062a\u06cc \u0648\u0627\u0631\u062f \u0645\u06cc \u0634\u0648\u062f. \u062b\u0628\u062a \u0634\u0645\u0627\u0631\u0647 \u062f\u0631 \u0631\u0633\u06cc\u062f \u062e\u0631\u06cc\u062f \u062f\u0627\u062e\u0644\u06cc \u0627\u062c\u0628\u0627\u0631\u06cc \u0627\u0633\u062a.\n\u2022 \u0627\u0645\u06a9\u0627\u0646 \u063a\u06cc\u0631 \u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0648\u06cc\u0698\u06af\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0628\u0639\u062f \u0627\u0632 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0645\u0639\u06cc\u0646 \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f \u0648 \u062f\u0631 \u0635\u0648\u0631\u062a \u0646\u06cc\u0627\u0632 \u0628\u0647 \u0639\u062f\u0645 \u0648\u0631\u0648\u062f \u062f\u06cc\u062a\u0627\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u0627\u06cc\u0646 \u0648\u06cc\u0698\u06af\u06cc \u0631\u0627 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u06a9\u0646\u06cc\u062f .\n\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u06a9\u0631\u062f\u0646 \u0648\u06cc\u0698\u06af\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0647\u0645\u0648\u0627\u0631\u0647 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f .\n\u2022 \u0627\u0645\u06a9\u0627\u0646 \u063a\u06cc\u0631 \u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0628\u0648\u062f\u0646 \u0648\u06cc\u0698\u06af\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0647\u0645\u0648\u0627\u0631\u0647 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f \u0648 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062f \u062f\u0631 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0645\u06cc \u0634\u0648\u062f.\n\u0648\u06cc\u0698\u06af\u06cc \u0645\u0642\u062f\u0627\u0631\u06cc: \u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0641\u06cc\u0644\u062f \u0648\u06cc\u0698\u06af\u06cc \u0645\u0642\u062f\u0627\u0631\u06cc \u060c \u062a\u06a9\u0645\u06cc\u0644 \u0641\u06cc\u0644\u062f \u0645\u0642\u062f\u0627\u0631 \u062f\u0631 \u0642\u0644\u0645 \u0627\u0633\u0646\u0627\u062f \u0627\u0645\u06a9\u0627\u0646 \u067e\u0630\u06cc\u0631 \u0628\u0648\u062f\u0647 \u0648 \u0627\u062c\u0628\u0627\u0631\u06cc \u0627\u0633\u062a.\n\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0648\u06cc\u0698\u06af\u06cc \u0645\u0642\u062f\u0627\u0631\u06cc \u0647\u0645\u0648\u0627\u0631\u0647 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f .\n\u0627\u0631\u0632 \u067e\u06cc\u0634 \u0641\u0631\u0636: \u062f\u0631 \u0635\u0648\u0631\u062a \u0627\u0646\u062a\u062e\u0627\u0628 \u0627\u0631\u0632 \u067e\u06cc\u0634 \u0641\u0631\u0636  \u060c \u0628\u0647 \u0647\u0646\u06af\u0627\u0645 \u0635\u062f\u0648\u0631 \u0633\u0646\u062f \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0641\u06cc\u0644\u062f\u0647\u0627\u06cc \u0627\u0631\u0632 \u0648 \u0627\u0631\u0632 \u0645\u0628\u0646\u0627 \u0642\u0644\u0645 \u0628\u0647 \u0635\u0648\u0631\u062a \u067e\u06cc\u0634 \u0641\u0631\u0636 \u0628\u0627 \u0627\u06cc\u0646 \u0627\u0631\u0632 \u062a\u06a9\u0645\u06cc\u0644 \u0645\u06cc \u0634\u0648\u062f . \u0627\u0645\u06a9\u0627\u0646 \u062a\u0639\u06cc\u06cc\u0646 \u0648 \u06cc\u0627 \u062d\u0630\u0641 \u0627\u0631\u0632 \u067e\u06cc\u0634 \u0641\u0631\u0636 \u0647\u0645\u0648\u0627\u0631\u0647 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f.\n\u0648\u06cc\u0698\u06af\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc: \u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0641\u06cc\u0644\u062f \u0648\u06cc\u0698\u06af\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc \u060c \u062a\u06a9\u0645\u06cc\u0644 \u0641\u06cc\u0644\u062f\u0647\u0627\u06cc \u0634\u0645\u0627\u0631\u0647 \u0648 \u062a\u0627\u0631\u06cc\u062e \u067e\u06cc\u06af\u06cc\u0631\u06cc \u062f\u0631 \u0642\u0644\u0645 \u0627\u0633\u0646\u0627\u062f \u0627\u0645\u06a9\u0627\u0646 \u067e\u0630\u06cc\u0631 \u0628\u0648\u062f\u0647 \u0648  \u0627\u062c\u0628\u0627\u0631\u06cc \u0627\u0633\u062a .\n\u2022 \u0627\u0645\u06a9\u0627\u0646 \u0641\u0639\u0627\u0644 \u06a9\u0631\u062f\u0646 \u0648\u06cc\u0698\u06af\u06cc \u067e\u06cc\u06af\u06cc\u0631\u06cc \u0647\u0645\u0648\u0627\u0631\u0647  \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f .\n\u0634\u0645\u0627\u0631\u0647 \u0631\u0648\u0632\u0627\u0646\u0647: \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062f \u060c \u0634\u0645\u0627\u0631\u0647 \u062a\u0631\u062a\u06cc\u0628 \u0627\u06cc\u062c\u0627\u062f \u0627\u0633\u0646\u0627\u062f \u062f\u0631 \u0647\u0631 \u0631\u0648\u0632 \u0645\u06cc \u0628\u0627\u0634\u062f\u060c \u0628\u0647 \u0635\u0648\u0631\u062a \u0633\u06cc\u0633\u062a\u0645\u06cc \u062b\u0628\u062a \u0645\u06cc\u0634\u0648\u062f \u0648 \u0642\u0627\u0628\u0644 \u0648\u06cc\u0631\u0627\u06cc\u0634 \u0646\u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f \u0648 \u0641\u0642\u0637 \u0628\u0627 \u0639\u0645\u0644\u06cc\u0627\u062a \u062c\u0627 \u0628\u0647 \u062c\u0627\u06cc\u06cc \u062f\u0631 \u0637\u06cc \u06cc\u06a9 \u0631\u0648\u0632 \u062a\u063a\u06cc\u06cc\u0631 \u0645\u06cc\u06a9\u0646\u062f.\n\u2022 \u0628\u0631\u0627\u06cc \u062a\u0631\u06a9\u06cc\u0628 \u06a9\u0645\u067e\u0627\u0646\u06cc + \u062f\u0641\u062a\u0631 + \u0633\u0627\u0644 \u0645\u0627\u0644\u06cc \u060c \u0628\u0627 \u0634\u0631\u0648\u0639 \u0627\u0632 1 \u062a\u0648\u0633\u0637 \u0633\u06cc\u0633\u062a\u0645 \u0634\u0631\u0648\u0639 \u0648 \u062f\u0631 \u0633\u0637\u062d \u0627\u06cc\u0646 \u062a\u0631\u06a9\u06cc\u0628 \u06cc\u06a9\u062a\u0627 \u0645\u06cc \u0628\u0627\u0634\u062f . \n\u2022 \u0627\u06af\u0631 \u062f\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u062f\u0641\u062a\u0631 \u06a9\u0644 \u0634\u0645\u0627\u0631\u0647 \u06af\u0630\u0627\u0631\u06cc \u0627\u0633\u0646\u0627\u062f \u062f\u0631 \u0633\u0637\u062d \u0634\u0639\u0628\u0647 \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647 \u0628\u0627\u0634\u062f \u060c \u0628\u0631\u0627\u06cc \u062a\u0631\u06a9\u06cc\u0628 \u06a9\u0645\u067e\u0627\u0646\u06cc + \u062f\u0641\u062a\u0631 + \u0633\u0627\u0644 \u0645\u0627\u0644\u06cc + \u0634\u0639\u0628\u0647 \u060c \u0645\u0642\u062f\u0627\u0631 \u0641\u06cc\u0644\u062f \u0634\u0645\u0627\u0631\u0647 \u0633\u0646\u062f \u0628\u0627 \u0634\u0631\u0648\u0639 \u0627\u0632 1 \u062a\u06a9\u0645\u06cc\u0644 \u0634\u062f\u0647 \u0648 \u062f\u0631 \u0633\u0637\u062d \u0627\u06cc\u0646 \u062a\u0631\u06a9\u06cc\u0628 \u06cc\u06a9\u062a\u0627 \u0645\u06cc \u0628\u0627\u0634\u062f.", "history": "user: \u06af\u0631\u0648\u0647\u0628\u0646\u062f\u06cc \u062a\u0641\u0635\u06cc\u0644 \u0686\u06cc\u0647\nassistant: \"\u06af\u0631\u0648\u0647\u0628\u0646\u062f\u06cc \u062a\u0641\u0635\u06cc\u0644\" \u062f\u0631 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0628\u0647 \u062a\u0642\u0633\u06cc\u0645 \u0628\u0646\u062f\u06cc \u062f\u0642\u06cc\u0642 \u0648 \u062c\u0632\u0626\u06cc \u062d\u0633\u0627\u0628 \u0647\u0627 \u06cc\u0627 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0634\u0627\u0631\u0647 \u062f\u0627\u0631\u062f. \u0628\u0631\u0627\u06cc \u0645\u062b\u0627\u0644\u060c \u062f\u0631 \u06cc\u06a9 \u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc\u060c \u0634\u0645\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u06af\u0631\u0648\u0647 \u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0641\u0631\u0648\u0634\u060c \u062e\u0631\u06cc\u062f\u060c \u0647\u0632\u06cc\u0646\u0647 \u0647\u0627\u06cc \u06a9\u0627\u0631\u0645\u0646\u062f\u0627\u0646\u060c \u062a\u0623\u0645\u06cc\u0646 \u0648 \u063a\u06cc\u0631\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f. \u0627\u06cc\u0646 \u06af\u0631\u0648\u0647\u0628\u0646\u062f\u06cc \u062a\u0641\u0635\u06cc\u0644 \u0628\u0647 \u0634\u0645\u0627 \u06a9\u0645\u06a9 \u0645\u06cc \u06