{"asctime": "2024-07-20 14:09:06,872", "levelname": "INFO", "message": "call llm", "session": "76ecad07-ca20-45ab-bece-a731ada07f67", "question": "\u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u0633\u0646\u062c\u0634 \u0631\u0627 \u06a9\u062c\u0627 \u0628\u0628\u06cc\u0646\u0645", "answer": "\u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647 \u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u0633\u0646\u062c\u0634\u060c \u0634\u0645\u0627 \u0628\u0627\u06cc\u062f \u0628\u0647 \u0645\u0627\u0698\u0648\u0644 \u0644\u062c\u0633\u062a\u06cc\u06a9 \u0645\u0631\u0627\u062c\u0639\u0647 \u06a9\u0646\u06cc\u062f. \u062f\u0631 \u0645\u0646\u0648 \u0627\u0646\u0628\u0627\u0631 \u0648 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u0646\u0628\u0627\u0631\u060c \u0642\u0633\u0645\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0627\u06cc\u0647 \u0631\u0627 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f \u0648 \u06af\u0632\u06cc\u0646\u0647 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0645\u0627\u06cc\u06cc\u062f. \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0644\u06cc\u0633\u062a \u062a\u0645\u0627\u0645 \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u0633\u0646\u062c\u0634 \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0628\u0631\u0627\u06cc \u0634\u0645\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.", "context": "1.5.1 \u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634\n  \u062f\u0631 \u0635\u0641\u062d\u0647 \u06cc \u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0645\u06cc \u062a\u0648\u0627\u0646 \u0644\u06cc\u0633\u062a\u06cc \u0627\u0632 \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u0633\u0646\u062c\u0634 \u062a\u0639\u0631\u06cc\u0641 \u0634\u062f\u0647 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0631\u0627 \u0645\u0634\u0627\u0647\u062f\u0647 \u06a9\u0631\u062f. \u0633\u062a\u0648\u0646 \u0647\u0627\u06cc \u0642\u0627\u0628\u0644 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0631 \u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632 \u0639\u0646\u0648\u0627\u0646\u060c \u0639\u0646\u0648\u0627\u0646 \u0628\u0647 \u0627\u062e\u062a\u0635\u0627\u0631\u060c \u0628\u0639\u062f \u0633\u0646\u062c\u0634 \u0648 \u0648\u0636\u0639\u06cc\u062a \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u0633\u0646\u062c\u0634.\n  \u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647\u06cc \u0644\u06cc\u0633\u062a \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u0633\u0646\u062c\u0634 \u0645\u06cc\u062a\u0648\u0627\u0646 \u0627\u0632 \u0645\u0646\u0648\u06cc \u0645\u0627\u0698\u0648\u0644 \u0644\u062c\u0633\u062a\u06cc\u06a9\u060c \u0627\u0646\u0628\u0627\u0631 \u0648 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u0646\u0628\u0627\u0631\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0627\u06cc\u0647\u060c \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0645\u0627\u06cc\u06cc\u062f.\n  \u062f\u0631 \u0628\u0627\u0644\u0627\u06cc \u0635\u0641\u062d\u0647 \u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u06af\u0632\u06cc\u0646\u0647 \u0648 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0632\u06cc\u0631 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f:\n\u2022 \u0646\u0627\u0645 \u0634\u0631\u06a9\u062a: \u0634\u0631\u06a9\u062a\u06cc \u0631\u0627 \u06a9\u0647 \u062f\u0631 \u0622\u0646 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0627\u06cc\u062c\u0627\u062f \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u0646\u0645\u0627\u06cc\u0634 \u0645\u06cc \u062f\u0647\u062f.\n\u2022 \u0630\u062e\u06cc\u0631\u0647: \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0627\u0645\u06a9\u0627\u0646 \"\u0630\u062e\u06cc\u0631\u0647\" \u0648 \"\u0630\u062e\u06cc\u0631\u0647 \u0648 \u0627\u06cc\u062c\u0627\u062f\" \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u062c\u062f\u06cc\u062f \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06cc \u06a9\u0646\u062f.\n\u2022 \u0633\u0627\u06cc\u0631 \u0639\u0645\u0644\u06cc\u0627\u062a: \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0627\u0645\u06a9\u0627\u0646 \u0627\u06cc\u062c\u0627\u062f \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u062c\u062f\u06cc\u062f \u0648 \u0646\u0645\u0627\u06cc\u0634 \u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u0633\u0646\u062c\u0634 \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06cc \u0633\u0627\u0632\u062f.\n1.5.3 \u0635\u0641\u062d\u0647 \u0645\u0634\u0627\u0647\u062f\u0647 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634\n  \u062f\u0631 \u0635\u0648\u0631\u062a \u0627\u0646\u062a\u062e\u0627\u0628 \u06cc\u06a9 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0627\u0632 \u0641\u0631\u0645 \u0641\u0647\u0631\u0633\u062a\u060c \u0641\u0631\u0645 \u0645\u0634\u0627\u0647\u062f\u0647 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0628\u0627 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0632\u06cc\u0631 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f:\n\u2022 \u0646\u0627\u0645 \u0634\u0631\u06a9\u062a: \u0634\u0631\u06a9\u062a\u06cc \u0631\u0627 \u06a9\u0647 \u062f\u0631 \u0622\u0646 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0627\u06cc\u062c\u0627\u062f \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u0646\u0645\u0627\u06cc\u0634 \u0645\u06cc \u062f\u0647\u062f.\n\u2022 \u0630\u062e\u06cc\u0631\u0647: \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u062d\u0627\u0644\u062a \u063a\u06cc\u0631 \u0641\u0639\u0627\u0644 \u0645\u06cc \u0628\u0627\u0634\u062f.\n\u2022 \u062c\u0633\u062a\u062c\u0648 \u0648 \u0641\u06cc\u0644\u062a\u0631: \u062f\u0631 \u0627\u06cc\u0646 \u0628\u062e\u0634 \u0645\u06cc \u062a\u0648\u0627\u0646 \u0633\u062a\u0648\u0646 \u0647\u0627\u06cc \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u062e\u0648\u062f \u0631\u0627 \u0628\u0631\u0627\u06cc \u0641\u06cc\u0644\u062a\u0631 \u06a9\u0631\u062f\u0646 \u0648 \u062c\u0633\u062a\u062c\u0648 \u0645\u06cc\u0627\u0646 \u062f\u0627\u062f\u0647 \u0647\u0627\u06cc \u0622\u0646 \u0633\u062a\u0648\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0645\u0648\u062f.\n\u2022 \u062a\u0646\u0638\u06cc\u0645 \u06a9\u0646\u0646\u062f\u0647 \u0639\u0631\u0636 \u0633\u062a\u0648\u0646: \u062a\u0646\u0638\u06cc\u0645 \u0627\u062a\u0648\u0645\u0627\u062a\u06cc\u06a9 \u0639\u0631\u0636 \u062a\u0645\u0627\u0645\u06cc \u0633\u062a\u0648\u0646 \u0647\u0627\u06cc \u062c\u062f\u0648\u0644 \u0641\u0647\u0631\u0633\u062a \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc \u0634\u0648\u062f.\n\u2022 \u062d\u0630\u0641: \u062f\u0631 \u0635\u0648\u0631\u062a \u0627\u0646\u062a\u062e\u0627\u0628 \u06cc\u06a9\u06cc \u0627\u0632 \u0631\u062f\u06cc\u0641 \u0647\u0627\u06cc \u0641\u0647\u0631\u0633\u062a\u060c \u06af\u0632\u06cc\u0646\u0647 \u062d\u0630\u0641 \u0641\u0639\u0627\u0644 \u0634\u062f\u0647 \u0648 \u0645\u06cc \u062a\u0648\u0627\u0646 \u0631\u06a9\u0648\u0631\u062f \u06cc\u0627 \u0631\u06a9\u0648\u0631\u062f\u0647\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647 \u0631\u0627 \u062d\u0630\u0641 \u0646\u0645\u0648\u062f.\n1.5.2 \u0645\u0631\u0627\u062d\u0644 \u062a\u0639\u0631\u06cc\u0641 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634\n1.5.2 \u0645\u0631\u0627\u062d\u0644 \u062a\u0639\u0631\u06cc\u0641 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634\n  \u0628\u0631\u0627\u06cc \u062a\u0639\u0631\u06cc\u0641 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u062f\u0631 \u0645\u0627\u0698\u0648\u0644 \u0644\u062c\u0633\u062a\u06cc\u06a9\u060c \u0627\u0632 \u0645\u0646\u0648 \u0627\u0646\u0628\u0627\u0631 \u0648 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u0646\u0628\u0627\u0631\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0627\u06cc\u0647\u060c \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634\u060c \u06af\u0632\u06cc\u0646\u0647 \u0645\u0639\u0631\u0641\u06cc \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 (+) \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0645\u0627\u06cc\u06cc\u062f.\n  \u0628\u0631\u0627\u06cc \u0645\u0639\u0631\u0641\u06cc \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u062f\u0631 \u0645\u0627\u0698\u0648\u0644 \u0644\u062c\u0633\u062a\u06cc\u06a9 \u0627\u0628\u062a\u062f\u0627 \u0639\u0646\u0648\u0627\u0646 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0648 \u0639\u0646\u0648\u0627\u0646 \u0628\u0647 \u0627\u062e\u062a\u0635\u0627\u0631 \u0631\u0627 \u062a\u0639\u0631\u06cc\u0641 \u06a9\u0631\u062f\u0647 \u0633\u067e\u0633 \u0628\u0639\u062f \u0633\u0646\u062c\u0634 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0645\u06cc \u06a9\u0646\u06cc\u0645. \u0627\u0628\u0639\u0627\u062f \u0633\u0646\u062c\u0634 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632:\n  \u0648\u0632\u0646\u060c \u062d\u062c\u0645\u060c \u0645\u062a\u0631\u0627\u0698\u060c \u0634\u0645\u0627\u0631\u0634\u06cc\u060c \u0632\u0645\u0627\u0646\u060c \u0627\u0646\u0631\u0698\u06cc\u060c \u062f\u0645\u0627\u060c \u0641\u0634\u0627\u0631 \u0648 \u0641\u0631\u06a9\u0627\u0646\u0633.\n  \u06af\u0632\u06cc\u0646\u0647 \u0647\u0627\u06cc \u0628\u0627\u0644\u0627\u06cc \u0635\u0641\u062d\u0647 \u06cc \u0627\u06cc\u062c\u0627\u062f \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u062c\u062f\u06cc\u062f \u0628\u0647 \u0634\u0631\u062d \u0632\u06cc\u0631 \u0645\u06cc \u0628\u0627\u0634\u062f:\n\u2022 \u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634: \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u06cc \u0622\u0628\u0634\u0627\u0631\u06cc \u0645\u06cc \u062a\u0648\u0627\u0646 \u0646\u0645\u0627\u0647\u0627\u06cc \u062a\u0639\u0631\u06cc\u0641 \u0634\u062f\u0647 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0631\u0627 \u0645\u0634\u0627\u0647\u062f\u0647 \u06a9\u0631\u062f\u0647 \u0648 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0646\u0645\u0627 \u0631\u0627 \u0630\u062e\u06cc\u0631\u0647 \u0648 \u0622\u0646 \u0647\u0627 \u0631\u0627 \u0645\u062f\u06cc\u0631\u06cc\u062a \u06a9\u0631\u062f. \u0628\u0647 \u0635\u0648\u0631\u062a \u067e\u06cc\u0634\u0641\u0631\u0636 \u0641\u0647\u0631\u0633\u062a \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f.\n\u2022 \u0646\u0627\u0645 \u0634\u0631\u06a9\u062a: \u062f\u0631 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0646\u0627\u0645 \u0634\u0631\u06a9\u062a \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f \u062f\u0631 \u0634\u0631\u06a9\u062a\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0628\u0647 \u0635\u0648\u0631\u062a \u06af\u0631\u0648\u0647 \u06cc\u0627 \u0647\u0644\u062f\u06cc\u0646\u06af \u0645\u06cc \u0628\u0627\u0634\u0646\u062f\u060c \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u06af\u0632\u06cc\u0646\u0647 \u0645\u06cc \u062a\u0648\u0627\u0646 \u062f\u0631 \u0635\u0648\u0631\u062a \u062f\u0627\u0634\u062a\u0646 \u062f\u0633\u062a\u0631\u0633\u06cc\u060c \u0634\u0631\u06a9\u062a \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u062e\u0648\u062f \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u062f \u062a\u0627 \u0628\u062a\u0648\u0627\u0646 \u0644\u06cc\u0633\u062a\u06cc \u0627\u0632 \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u0633\u0646\u062c\u0634 \u062a\u0639\u0631\u06cc\u0641 \u0634\u062f\u0647 \u0645\u062e\u062a\u0635 \u0622\u0646 \u0634\u0631\u06a9\u062a \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u0631\u0627 \u0645\u0634\u0627\u0647\u062f\u0647 \u06a9\u0631\u062f.", "history": "user: \u0686\u06af\u0648\u0646\u0647 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0627\u0646\u0628\u0627\u0631 \u062a\u0639\u0631\u06cc\u0641 \u06a9\u0646\u0645\nassistant: \u0628\u0631\u0627\u06cc \u062a\u0639\u0631\u06cc\u0641 \u06a9\u0627\u0644\u0627 \u062f\u0631 \u0645\u0627\u0698\u0648\u0644 \u0644\u062c\u0633\u062a\u06cc\u06a9\u060c \u0628\u0627\u06cc\u062f \u0628\u0647 \u0645\u0646\u0648 \u0627\u0646\u0628\u0627\u0631 \u0648 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u0646\u0628\u0627\u0631 \u0645\u0631\u0627\u062c\u0639\u0647 \u06a9\u0646\u06cc\u062f. \u0633\u067e\u0633 \u0627\u0632 \u0642\u0633\u0645\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0627\u06cc\u0647\u060c \u06af\u0632\u06cc\u0646\u0647 \"\u0645\u0639\u0631\u0641\u06cc \u06a9\u0627\u0644\u0627\" \u0631\u0627 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0639\u0644\u0627\u0645\u062a (+) \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f. \u062f\u0631 \u0635\u0641\u062d\u0647 \u062a\u0639\u0631\u06cc\u0641 \u06a9\u0627\u0644\u0627\u060c \u0634\u0645\u0627 \u0628\u0627\u06cc\u062f \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u06a9\u0627\u0644\u0627 \u0631\u0627 \u0648\u0627\u0631\u062f \u06a9\u0646\u06cc\u062f \u0634\u0627\u0645\u0644 \u0646\u0627\u0645 \u06a9\u0627\u0644\u0627\u060c \u062a\u0648\u0636\u06cc\u062d\u0627\u062a\u060c \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0648 \u063a\u06cc\u0631\u0647.", "timestamp": "2024-07-20T14:09:06.872761+00:00"}
{"asctime": "2024-07-20 14:10:35,893", "levelname": "INFO", "message": "call llm", "session": "76ecad07-ca20-45ab-bece-a731ada07f67", "question": "\u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u0686\u06cc\u0633\u062a", "answer": "\u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u062f\u0631 \u0645\u0627\u0698\u0648\u0644 \u0644\u062c\u0633\u062a\u06cc\u06a9\u060c \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u0627\u0632 \u062d\u0633\u0627\u0628\u200c\u0647\u0627 \u0628\u0627 \u0648\u06cc\u0698\u06af\u06cc\u200c\u0647\u0627\u06cc \u0645\u0634\u0627\u0628\u0647 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0631\u0627\u06cc \u0633\u0627\u062f\u06af\u06cc \u062f\u0631 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0648 \u06af\u0632\u0627\u0631\u0634\u200c\u062f\u0647\u06cc \u0628\u0647 \u06a9\u0627\u0631 \u0645\u06cc\u200c\u0631\u0648\u062f. \u0628\u0631\u0627\u06cc \u062a\u0639\u0631\u06cc\u0641 \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628\u060c \u0628\u0627\u06cc\u062f \u0628\u0647 \u0645\u0646\u0648 \u0627\u0646\u0628\u0627\u0631 \u0648 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u0646\u0628\u0627\u0631\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0627\u06cc\u0647\u060c \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0645\u0631\u0627\u062c\u0639\u0647 \u06a9\u0646\u06cc\u062f \u0648 \u06af\u0632\u06cc\u0646\u0647 \u0645\u0639\u0631\u0641\u06cc \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 (+) \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0645\u0627\u06cc\u06cc\u062f. \u062f\u0631 \u0627\u06cc\u0646\u062c\u0627 \u0628\u0627\u06cc\u062f \u06a9\u062f\u060c \u0639\u0646\u0648\u0627\u0646 \u0648 \u0631\u0648\u0634 \u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u0631\u0627 \u0645\u0634\u062e\u0635 \u06a9\u0646\u06cc\u062f. \u0627\u0646\u0648\u0627\u0639 \u0631\u0648\u0634\u200c\u0647\u0627\u06cc \u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632 \u0645\u06cc\u0627\u0646\u06af\u06cc\u0646\u060c \u0641\u0627\u06cc\u0641\u0648 (FIFO)\u060c \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0648\u06cc\u0698\u0647 \u0648 \u063a\u06cc\u0631\u0647.", "context": "1.6 \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628\n  \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0627\u0646\u0628\u0627\u0631\u060c \u0627\u0632 \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u0628\u0631\u0627\u06cc \u062a\u0639\u06cc\u06cc\u0646 \u0631\u0648\u0634 \u0642\u06cc\u0645\u062a \u06af\u0630\u0627\u0631\u06cc \u0647\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f.\n1.6.1 \u0641\u0647\u0631\u0633\u062a \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628\n  \u062f\u0631 \u0635\u0641\u062d\u0647 \u06cc \u0641\u0647\u0631\u0633\u062a \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u0645\u06cc \u062a\u0648\u0627\u0646 \u0644\u06cc\u0633\u062a\u06cc \u0627\u0632 \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u062a\u0639\u0631\u06cc\u0641 \u0634\u062f\u0647 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u0631\u0627 \u0645\u0634\u0627\u0647\u062f\u0647 \u06a9\u0631\u062f. \u0633\u062a\u0648\u0646 \u0647\u0627\u06cc \u0642\u0627\u0628\u0644 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0631 \u0641\u0647\u0631\u0633\u062a \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632 \u06a9\u062f\u060c \u0639\u0646\u0648\u0627\u0646\u060c \u0631\u0648\u0634 \u0642\u06cc\u0645\u062a \u06af\u0630\u0627\u0631\u06cc\u060c \u0648 \u0648\u0636\u0639\u06cc\u062a.\n  \u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647\u06cc \u0644\u06cc\u0633\u062a \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u0645\u06cc\u062a\u0648\u0627\u0646 \u0627\u0632 \u0645\u0646\u0648\u06cc \u0645\u0627\u0698\u0648\u0644 \u0644\u062c\u0633\u062a\u06cc\u06a9\u060c \u0627\u0646\u0628\u0627\u0631 \u0648 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u0646\u0628\u0627\u0631\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0627\u06cc\u0647\u060c \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0645\u0627\u06cc\u06cc\u062f.\n  \u062f\u0631 \u0628\u0627\u0644\u0627\u06cc \u0635\u0641\u062d\u0647 \u0641\u0647\u0631\u0633\u062a \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u06af\u0632\u06cc\u0646\u0647 \u0648 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0632\u06cc\u0631 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f:\n\ufeff\u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u0633\u0627\u0628 \u0647\u0627\n\u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u0633\u0627\u0628 \u0641\u0647\u0631\u0633\u062a\u06cc \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u0622\u0646 \u062d\u0633\u0627\u0628\u200c\u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u062f\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u0648 \u06a9\u062f\u06af\u0630\u0627\u0631\u06cc \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0628\u0647 \u0645\u0646\u0638\u0648\u0631 \u0633\u0627\u0632\u0645\u0627\u0646\u062f\u0647\u06cc \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u0627\u0644\u06cc\u060c \u062a\u0633\u0647\u06cc\u0644 \u062b\u0628\u062a \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0648 \u062a\u0647\u06cc\u0647 \u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627\u06cc \u062f\u0642\u06cc\u0642 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0634\u0648\u062f.\n\u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0645\u0639\u0645\u0648\u0644\u0627\u064b \u0628\u0647 \u0635\u0648\u0631\u062a \u0633\u0644\u0633\u0644\u0647 \u0645\u0631\u0627\u062a\u0628\u06cc \u0648 \u0686\u0646\u062f \u0633\u0637\u062d\u06cc \u0627\u0633\u062a\u060c \u0628\u0647 \u0627\u06cc\u0646 \u0645\u0639\u0646\u06cc \u06a9\u0647 \u062d\u0633\u0627\u0628\u200c\u0647\u0627 \u0628\u0647 \u062f\u0633\u062a\u0647\u200c\u0647\u0627\u06cc \u06a9\u0644\u06cc\u200c\u062a\u0631 \u0648 \u062c\u0632\u0626\u06cc\u200c\u062a\u0631 \u062a\u0642\u0633\u06cc\u0645 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0647\u0631 \u0633\u0637\u062d \u0627\u0632 \u0627\u06cc\u0646 \u0633\u0627\u062e\u062a\u0627\u0631\u060c \u062c\u0632\u0626\u06cc\u0627\u062a \u0628\u06cc\u0634\u062a\u0631\u06cc \u0631\u0627 \u062f\u0631 \u0645\u0648\u0631\u062f \u0645\u0627\u0647\u06cc\u062a \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc\u200c\u062f\u0647\u062f.\n\u0633\u0637\u0648\u062d \u0631\u0627\u06cc\u062c \u062f\u0631 \u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u0633\u0627\u0628 \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632:\n1.6.2 \u0645\u0631\u0627\u062d\u0644 \u062a\u0639\u0631\u06cc\u0641 \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628\n  \u0628\u0631\u0627\u06cc \u062a\u0639\u0631\u06cc\u0641 \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u062f\u0631 \u0645\u0627\u0698\u0648\u0644 \u0644\u062c\u0633\u062a\u06cc\u06a9\u060c \u0627\u0632 \u0645\u0646\u0648 \u0627\u0646\u0628\u0627\u0631 \u0648 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u0646\u0628\u0627\u0631\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0627\u06cc\u0647\u060c \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634\u060c \u06af\u0632\u06cc\u0646\u0647 \u0645\u0639\u0631\u0641\u06cc \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 (+) \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0645\u0627\u06cc\u06cc\u062f.\n  \u0628\u0631\u0627\u06cc \u0645\u0639\u0631\u0641\u06cc \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u062f\u0631 \u0645\u0627\u0698\u0648\u0644 \u0644\u062c\u0633\u062a\u06cc\u06a9 \u0627\u0628\u062a\u062f\u0627 \u06a9\u062f\u060c \u0639\u0646\u0648\u0627\u0646 \u0648 \u0631\u0648\u0634 \u0642\u06cc\u0645\u062a \u06af\u0630\u0627\u0631\u06cc \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u0627\u0646\u062a\u062e\u0627\u0628 \u0645\u06cc \u0634\u0648\u062f. \u0627\u0646\u0648\u0627\u0639 \u0631\u0648\u0634 \u0647\u0627\u06cc \u0642\u06cc\u0645\u062a \u06af\u0630\u0627\u0631\u06cc \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632 \u0645\u06cc\u0627\u0646\u06af\u06cc\u0646\u060c \u0641\u0627\u06cc\u0641\u0648\u060c \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0648\u06cc\u0698\u0647\n  \u06af\u0632\u06cc\u0646\u0647 \u0647\u0627\u06cc \u0628\u0627\u0644\u0627\u06cc \u0635\u0641\u062d\u0647 \u06cc \u0627\u06cc\u062c\u0627\u062f \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u062c\u062f\u06cc\u062f \u0628\u0647 \u0634\u0631\u062d \u0632\u06cc\u0631 \u0645\u06cc \u0628\u0627\u0634\u062f:\n\u2022 \u0646\u0627\u0645 \u0634\u0631\u06a9\u062a: \u0634\u0631\u06a9\u062a\u06cc \u0631\u0627 \u06a9\u0647 \u062f\u0631 \u0622\u0646 \u0637\u0628\u0642\u0647 \u062d\u0633\u0627\u0628 \u0627\u06cc\u062c\u0627\u062f \u0645\u06cc \u06a9\u0646\u06cc\u0645 \u0646\u0645\u0627\u06cc\u0634 \u0645\u06cc \u062f\u0647\u062f.\n\u0633\u0637\u0648\u062d \u0631\u0627\u06cc\u062c \u062f\u0631 \u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u0633\u0627\u0628 \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632:\n\u2022 \u06af\u0631\u0648\u0647 \u062d\u0633\u0627\u0628 \u0647\u0627 : \u0628\u0627\u0644\u0627\u062a\u0631\u06cc\u0646 \u0633\u0637\u062d \u062f\u0631 \u0627\u06cc\u0646 \u0633\u0627\u062e\u062a\u0627\u0631 \u0647\u0633\u062a\u0646\u062f \u0648 \u062f\u0633\u062a\u0647\u200c\u0647\u0627\u06cc \u06a9\u0644\u06cc \u0627\u0632 \u0641\u0639\u0627\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0645\u0627\u0644\u06cc \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u0646\u062f. \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0645\u062b\u0627\u0644\u060c \u062f\u0627\u0631\u0627\u06cc\u06cc\u200c\u0647\u0627\u060c \u0628\u062f\u0647\u06cc\u200c\u0647\u0627\u060c \u062d\u0642\u0648\u0642 \u0635\u0627\u062d\u0628\u0627\u0646 \u0633\u0647\u0627\u0645\u060c \u062f\u0631\u0622\u0645\u062f \u0648 \u0647\u0632\u06cc\u0646\u0647\u200c\u0647\u0627 \u06af\u0631\u0648\u0647 \u062d\u0633\u0627\u0628 \u0647\u0633\u062a\u0646\u062f.\n\u0627\u06cc\u0646 \u062d\u0633\u0627\u0628\u200c\u0647\u0627 \u0648\u0635\u0648\u0644 \u0634\u062f\u0646\u06cc \u0646\u06cc\u0633\u062a\u0646\u062f \u0648 \u0641\u0642\u0637 \u0628\u0647 \u0635\u0648\u0631\u062a \u0648\u062b\u06cc\u0642\u0647 \u06a9\u0627\u0631\u0628\u0631\u062f \u062f\u0627\u0631\u0646\u062f \u0648 \u0628\u0647 \u062f\u0644\u06cc\u0644 \u0628\u062f\u0648\u0646 \u0645\u0627\u0647\u06cc\u062a \u0628\u0648\u062f\u0646\u060c \u062f\u0631 \u062a\u0631\u0627\u0632\u0646\u0627\u0645\u0647 \u06cc\u0627 \u0635\u0648\u0631\u062a \u0633\u0648\u062f \u0648 \u0632\u06cc\u0627\u0646 \u062b\u0628\u062a \u0646\u0645\u06cc\u0634\u0648\u0646\u062f \u0648 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0641\u0642\u0637 \u062f\u0631 \u0630\u06cc\u0644 \u062a\u0631\u0627\u0632\u0646\u0627\u0645\u0647 \u0628\u0647 \u0635\u0648\u0631\u062a \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u06a9\u0648\u0686\u06a9\u06cc \u0622\u0648\u0631\u062f\u0647 \u0634\u0648\u0646\u062f.\n\u0645\u0627\u0647\u06cc\u062a \u062d\u0633\u0627\u0628\n\u062d\u0633\u0627\u0628 \u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641 \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0628\u0631 \u0627\u0633\u0627\u0633 \u0645\u0627\u0647\u06cc\u062a \u0622\u0646\u0647\u0627 \u0628\u0647 \u062f\u0633\u062a\u0647 \u0647\u0627\u06cc \u0632\u06cc\u0631 \u062a\u0642\u0633\u06cc\u0645 \u0645\u06cc \u0634\u0648\u0646\u062f:\n\u0628\u062f\u0647\u06a9\u0627\u0631: \u062f\u0627\u0631\u0627\u06cc\u06cc \u0647\u0627\u060c \u0647\u0632\u06cc\u0646\u0647 \u0647\u0627 \u0648 \u0633\u0648\u062f \u0648 \u0632\u06cc\u0627\u0646\n\u0628\u0633\u062a\u0627\u0646\u06a9\u0627\u0631: \u0628\u062f\u0647\u06cc \u0647\u0627\u060c \u0633\u0631\u0645\u0627\u06cc\u0647 \u0648 \u062f\u0631\u0622\u0645\u062f\u0647\u0