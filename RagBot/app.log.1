{"asctime": "2024-07-22 10:26:20,291", "levelname": "INFO", "message": "call llm", "session": "0afeae5f-dda5-42d8-9e80-5fb60e8227a7", "question": "\u0645\u0648\u0627\u0632\u0646\u0647 \u0645\u0628\u0644\u063a \u0686\u06cc\u0633\u062a", "answer": "\u0645\u0648\u0627\u0632\u0646\u0647 \u0645\u0628\u0644\u063a \u062f\u0631 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0628\u0647 \u0645\u0639\u0646\u0627\u06cc \u0645\u0642\u0627\u06cc\u0633\u0647 \u06a9\u0644\u06cc\u0647 \u0648\u0627\u0631\u06cc\u0632\u0647\u0627 \u0648 \u0628\u0631\u062f\u0627\u0634\u062a \u0647\u0627 \u062f\u0631 \u06cc\u06a9 \u062d\u0633\u0627\u0628 \u062e\u0627\u0635 \u0627\u0633\u062a. \u0627\u06cc\u0646 \u0639\u0645\u0644\u06cc\u0627\u062a \u0628\u0631\u0627\u06cc \u062a\u0623\u06cc\u06cc\u062f \u0635\u062d\u062a \u0648 \u062f\u0642\u062a \u062b\u0628\u062a \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0648 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062e\u0637\u0627\u0647\u0627\u06cc \u0645\u062d\u0627\u0633\u0628\u0627\u062a\u06cc \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc \u0634\u0648\u062f. \u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u0645\u0648\u0627\u0632\u0646\u0647 \u0645\u0628\u0644\u063a\u060c \u0645\u06cc \u062a\u0648\u0627\u0646 \u0645\u0634\u0627\u0647\u062f\u0647 \u06a9\u0631\u062f \u06a9\u0647 \u0622\u06cc\u0627 \u0645\u062c\u0645\u0648\u0639 \u06a9\u0644\u06cc\u0647 \u0628\u0631\u062f\u0627\u0634\u062a \u0647\u0627 \u0628\u0631\u0627\u0628\u0631 \u0627\u0633\u062a \u0628\u0627 \u0645\u062c\u0645\u0648\u0639 \u06a9\u0644\u06cc\u0647 \u0648\u0627\u0631\u06cc\u0632\u0647\u0627 \u06cc\u0627 \u062e\u06cc\u0631.", "context": "\u0645\u0648\u0627\u0632\u0646\u0647 \u0645\u0628\u0644\u063a: \n\u0628\u0627 \u0627\u06cc\u0646 \u0627\u06a9\u0634\u0646 \u0646\u06cc\u0627\u0632\u06cc \u0628\u0647 \u062b\u0628\u062a \u0645\u0628\u0644\u063a \u062f\u0631 \u0642\u0644\u0645 \u0646\u062f\u0627\u0631\u06cc\u062f \u0648 \u0633\u06cc\u0633\u062a\u0645 \u0645\u0628\u0627\u0644\u063a \u0633\u0627\u06cc\u0631 \u0631\u062f\u06cc\u0641 \u0647\u0627 \u0631\u0627 \u0645\u062d\u0627\u0633\u0628\u0647 \u0648 \u0645\u0628\u0644\u063a\u06cc \u06a9\u0647 \u0628\u0627\u0639\u062b \u0645\u0648\u0627\u0632\u0646\u0647 \u0633\u0646\u062f \u0645\u06cc \u0634\u0648\u062f \u0631\u0627 \u062f\u0631 \u0631\u062f\u06cc\u0641 \u062c\u0627\u0631\u06cc \u062b\u0628\u062a \u0645\u06cc \u06a9\u0646\u062f.\n\u0633\u06cc\u0633\u062a\u0645 \u0628\u0627 \u062c\u0645\u0639 \u0645\u0628\u0644\u063a \u0631\u062f\u06cc\u0641 \u0647\u0627\u06cc \u062b\u0628\u062a \u0634\u062f\u0647 \u0648 \u06a9\u0645 \u06a9\u0631\u062f\u0646 \u0633\u0631\u062c\u0645\u0639 \u0628\u062f\u0647\u06a9\u0627\u0631 \u0627\u0632 \u0633\u0631\u062c\u0645\u0639 \u0628\u0633\u062a\u0627\u0646\u06a9\u0627\u0631 \u0628\u0631\u0627\u06cc \u0642\u0644\u0645 \u0647\u0627\u06cc\u06cc \u06a9\u0647 \u062a\u0627\u06a9\u0646\u0648\u0646 \u062b\u0628\u062a \u0634\u062f\u0647 \u0627\u0633\u062a \u060c \u0645\u0628\u0644\u063a \u0645\u0648\u0627\u0632\u0646\u0647 \u0631\u0627 \u062a\u0634\u062e\u06cc\u0635 \u0645\u06cc \u062f\u0647\u062f .\n\u0627\u06af\u0631 \u0645\u0627\u0646\u062f\u0647 \u0645\u062d\u0627\u0633\u0628\u0647 \u0635\u0641\u0631 \u0628\u0627\u0634\u062f \u060c \u0628\u0647 \u06a9\u0627\u0631\u0628\u0631 \u067e\u06cc\u063a\u0627\u0645 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f \u06a9\u0647 \u0628\u062f\u0648\u0646 \u062b\u0628\u062a \u0642\u0644\u0645 \u0645\u0648\u0627\u0632\u0646\u0647 \u060c \u0633\u0646\u062f \u0628\u0627\u0644\u0627\u0646\u0633 \u0627\u0633\u062a .\n\u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06cc\u06a9\u06cc \u0627\u0632 \u0627\u0642\u0644\u0627\u0645 \u0633\u0646\u062f\u060c \u0627\u06a9\u0634\u0646 \u0647\u0627\u06cc \u0632\u06cc\u0631 \u0628\u0647 \u0634\u0645\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f:\n\u2022 \u0627\u0632 \u0646\u0638\u0631 \u0646\u0648\u0639 \u062d\u0633\u0627\u0628 \u0628\u0627 \u0645\u0639\u06cc\u0646 \u062c\u0627\u0631\u06cc \u06cc\u06a9\u0633\u0627\u0646 \u0628\u0627\u0634\u062f\n\u2022 \u0627\u0632 \u0646\u0638\u0631 \u0648\u06cc\u0698\u06af\u06cc \u0647\u0627\u06cc \u0627\u0631\u0632\u06cc (\u0627\u0646\u062a\u062e\u0627\u0628 \u0648\u06cc\u0698\u06af\u06cc \u0648 \u0642\u0644\u0645 \u067e\u0648\u0644\u06cc)\u060c \u067e\u06cc\u06af\u06cc\u0631\u06cc (\u0627\u0646\u062a\u062e\u0627\u0628 \u0648\u06cc\u0698\u06af\u06cc \u0648 \u0627\u062c\u0628\u0627\u0631\u06cc \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0628\u0648\u062f\u0646 \u0622\u0646)\u060c \u0645\u0642\u062f\u0627\u0631\u06cc (\u0627\u0646\u062a\u062e\u0627\u0628 \u0648\u06cc\u0698\u06af\u06cc \u0648 \u0627\u062c\u0628\u0627\u0631\u06cc \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0628\u0648\u062f\u0646 \u0622\u0646) \u0628\u0627 \u0645\u0639\u06cc\u0646 \u062c\u0627\u0631\u06cc \u06cc\u06a9\u0633\u0627\u0646 \u0628\u0627\u0634\u062f\n\u2022 \u062a\u0641\u0635\u06cc\u0644\u06cc \u0647\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647 \u062f\u0631 \u0622\u0646 \u062f\u0642\u06cc\u0642\u0627 \u0628\u0631\u0627\u0628\u0631 \u0628\u0627  \u062a\u0641\u0635\u06cc\u0644 \u0647\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647 \u0628\u0631\u0627\u06cc  \u0645\u0639\u06cc\u0646 \u062c\u0627\u0631\u06cc \u0628\u0627\u0634\u062f\n\u2022 \u0627\u0632 \u0646\u0638\u0631 \u0627\u062c\u0628\u0627\u0631\u06cc \u0648 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0628\u0648\u062f\u0646 \u062a\u0641\u0635\u06cc\u0644 \u060c \u0647\u0645\u0647 \u0627\u0646\u0648\u0627\u0639 \u062a\u0641\u0635\u06cc\u0644 \u0627\u062c\u0628\u0627\u0631\u06cc \u062f\u0631 \u062d\u0633\u0627\u0628 \u0645\u0639\u06cc\u0646 \u062c\u0627\u0631\u06cc \u0645\u06cc \u062a\u0648\u0627\u0646\u062f \u062f\u0631 \u062d\u0633\u0627\u0628 \u0645\u0642\u0627\u0628\u0644 \u0627\u062c\u0628\u0627\u0631\u06cc \u06cc\u0627 \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0628\u0627\u0634\u062f \u060c \u0627\u0645\u0627 \u0627\u06af\u0631 \u0633\u0645\u062a \u062d\u0633\u0627\u0628 \u062c\u0627\u0631\u06cc \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0628\u0627\u0634\u062f \u060c \u0633\u0645\u062a \u062d\u0633\u0627\u0628 \u0645\u0642\u0627\u0628\u0644 \u0628\u0627\u06cc\u062f \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0628\u0627\u0634\u062f\n\u062d\u0633\u0627\u0628 \u0645\u0642\u0627\u0628\u0644 \u062a\u0639\u062f\u06cc\u0644 \u0645\u0627\u0647\u06cc\u062a: \u0628\u0631\u0627\u06cc \u062d\u0633\u0627\u0628 \u0647\u0627\u06cc \u0645\u0639\u06cc\u0646 \u0628\u0627 \u0645\u0627\u0647\u06cc\u062a \"\u0628\u062f\u0647\u06a9\u0627\u0631\" \u06cc\u0627 \"\u0628\u0633\u062a\u0627\u0646\u06a9\u0627\u0631\" \u0645\u06cc \u062a\u0648\u0627\u0646\u06cc\u062f \u062d\u0633\u0627\u0628 \u0647\u0627\u06cc \u0637\u0631\u0641 \u0645\u0642\u0627\u0628\u0644 \u0631\u0627 \u0645\u0634\u062e\u0635 \u0646\u0645\u0627\u06cc\u06cc\u062f. \u0628\u0631\u0627\u06cc \u0635\u062f\u0648\u0631 \u0633\u0646\u062f \u062a\u0639\u062f\u06cc\u0644 \u0645\u0627\u0647\u06cc\u062a\u060c \u0628\u0631\u0627\u06cc \u062d\u0633\u0627\u0628 \u0647\u0627\u06cc \u062e\u0644\u0627\u0641 \u0645\u0627\u0647\u06cc\u062a \u0634\u062f\u0647\u060c \u0648\u062c\u0648\u062f \u062d\u0633\u0627\u0628 \u0645\u0642\u0627\u0628\u0644 \u062a\u0639\u062f\u06cc\u0644 \u0645\u0627\u0647\u06cc\u062a \u0627\u062c\u0628\u0627\u0631\u06cc \u0627\u0633\u062a.\n\u062d\u0633\u0627\u0628 \u0645\u0639\u06cc\u0646\u06cc \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u062d\u0633\u0627\u0628 \u0645\u0642\u0627\u0628\u0644 \u062a\u0639\u062f\u06cc\u0644 \u0645\u0627\u0647\u06cc\u062a \u0642\u0627\u0628\u0644 \u0627\u0646\u062a\u062e\u0627\u0628 \u0627\u0633\u062a \u06a9\u0647:\n\u2022 \u0641\u0639\u0627\u0644 \u0628\u0627\u0634\u062f\n\u2022 \u0627\u0632 \u0646\u0638\u0631 \u0646\u0648\u0639 \u062d\u0633\u0627\u0628 \u0628\u0627 \u0645\u0639\u06cc\u0646 \u062c\u0627\u0631\u06cc \u06cc\u06a9\u0633\u0627\u0646 \u0628\u0627\u0634\u062f\n\u2022 \u0645\u0642\u062f\u0627\u0631 \u0641\u06cc\u0644\u062f \u0645\u0627\u0647\u06cc\u062a \u062d\u0633\u0627\u0628 \u0622\u0646 \u062e\u0644\u0627\u0641 \u0645\u0627\u0647\u06cc\u062a \u062d\u0633\u0627\u0628 \u0645\u0639\u06cc\u0646 \u062c\u0627\u0631\u06cc \u0628\u0627\u0634\u062f\n\u06a9\u0646\u062a\u0631\u0644 \u0645\u0627\u0647\u06cc\u062a \u062d\u0633\u0627\u0628 \u0637\u06cc \u0633\u0627\u0644: \u062f\u0631 \u0641\u06cc\u0644\u062f \u06a9\u0646\u062a\u0631\u0644 \u0645\u0627\u0647\u06cc\u062a \u062d\u0633\u0627\u0628 \u0628\u0647 \u0635\u0648\u0631\u062a \u067e\u06cc\u0634 \u0641\u0631\u0636 \"\u0628\u062f\u0648\u0646 \u06a9\u0646\u062a\u0631\u0644\" \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647 \u0627\u0633\u062a. \u0628\u0631\u0627\u06cc \u0645\u0639\u06cc\u0646 \u0647\u0627\u06cc \u062f\u0627\u0631\u0627\u06cc \u0645\u0627\u0647\u06cc\u062a \u0628\u062f\u0647\u06a9\u0627\u0631 \u0648 \u0628\u0633\u062a\u0627\u0646\u06a9\u0627\u0631\u060c \u0627\u0645\u06a9\u0627\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u06cc\u06a9\u06cc \u0627\u0632 \u062d\u0627\u0644\u0627\u062a \"\u0645\u0639\u06cc\u0646\"/\"\u0645\u0639\u06cc\u0646 \u0648 \u062a\u0641\u0635\u06cc\u0644 \u0627\u0646\u062a\u062e\u0627\u0628\u06cc\" \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u0627\u0646\u062a\u062e\u0627\u0628  \"\u0645\u0639\u06cc\u0646\"\u060c \u062f\u0631 \u0647\u0646\u06af\u0627\u0645 \u062b\u0628\u062a \u0633\u0646\u062f \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u06af\u0631 \u0645\u0639\u06cc\u0646 \u062e\u0644\u0627\u0641 \u0645\u0627\u0647\u06cc\u062a \u0634\u0648\u062f\u060c \u0630\u062e\u06cc\u0631\u0647 \u0633\u0646\u062f \u0628\u0627 \u062e\u0637\u0627 \u0645\u0648\u0627\u062c\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f. \u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06af\u0632\u06cc\u0646\u0647 \" \u0645\u0639\u06cc\u0646 \u0648 \u062a\u0641\u0635\u06cc\u0644 \u0627\u0646\u062a\u062e\u0627\u0628\u06cc\" \u060c \u0627\u06cc\u0646 \u06a9\u0646\u062a\u0631\u0644 \u062f\u0631 \u0633\u0637\u062d \u0645\u0639\u06cc\u0646 \u0648 \u062a\u0641\u0635\u06cc\u0644 \u0642\u0644\u0645 \u0633\u0646\u062f \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u0634\u0648\u062f.\n\u0633\u0637\u0648\u062d \u0631\u0627\u06cc\u062c \u062f\u0631 \u0633\u0627\u062e\u062a\u0627\u0631 \u062d\u0633\u0627\u0628 \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632:\n\u2022 \u06af\u0631\u0648\u0647 \u062d\u0633\u0627\u0628 \u0647\u0627 : \u0628\u0627\u0644\u0627\u062a\u0631\u06cc\u0646 \u0633\u0637\u062d \u062f\u0631 \u0627\u06cc\u0646 \u0633\u0627\u062e\u062a\u0627\u0631 \u0647\u0633\u062a\u0646\u062f \u0648 \u062f\u0633\u062a\u0647\u200c\u0647\u0627\u06cc \u06a9\u0644\u06cc \u0627\u0632 \u0641\u0639\u0627\u0644\u06cc\u062a\u200c\u0647\u0627\u06cc \u0645\u0627\u0644\u06cc \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u0646\u062f. \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0645\u062b\u0627\u0644\u060c \u062f\u0627\u0631\u0627\u06cc\u06cc\u200c\u0647\u0627\u060c \u0628\u062f\u0647\u06cc\u200c\u0647\u0627\u060c \u062d\u0642\u0648\u0642 \u0635\u0627\u062d\u0628\u0627\u0646 \u0633\u0647\u0627\u0645\u060c \u062f\u0631\u0622\u0645\u062f \u0648 \u0647\u0632\u06cc\u0646\u0647\u200c\u0647\u0627 \u06af\u0631\u0648\u0647 \u062d\u0633\u0627\u0628 \u0647\u0633\u062a\u0646\u062f.", "history": "user: \u0633\u0646\u062f \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0686\u06cc\u0647\nassistant: \u0633\u0646\u062f \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u062f\u0631 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0645\u0639\u0645\u0648\u0644\u0627\u064b \u0628\u0631\u0627\u06cc \u062b\u0628\u062a \u062a\u0648\u0636\u06cc\u062d\u0627\u062a\u060c \u062c\u0632\u0626\u06cc\u0627\u062a \u0627\u0636\u0627\u0641\u06cc \u06cc\u0627 \u0646\u06a9\u0627\u062a \u0645\u0647\u0645 \u062f\u0631\u0628\u0627\u0631\u0647 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f. \u0627\u06cc\u0646 \u0633\u0646\u062f \u0647\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0634\u0627\u0645\u0644 \u062a\u0648\u0636\u06cc\u062d\u0627\u062a \u062f\u0631\u0628\u0627\u0631\u0647 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc\u060c \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0642\u06cc\u0645\u062a\u060c \u062a\u062e\u0641\u06cc\u0641\u0627\u062a \u0648 \u063a\u06cc\u0631\u0647 \u0628\u0627\u0634\u0646\u062f. \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0647\u0627 \u0645\u0639\u0645\u0648\u0644\u0627\u064b \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0633\u0646\u062f \u0647\u0627\u06cc \u0645\u0627\u0644\u06cc \u06cc\u06a9 \u0634\u0631\u06a9\u062a \u062f\u0631 \u0646\u0638\u0631 \u06af\u0631\u0641\u062a\u0647 \u0645\u06cc \u0634\u0648\u0646\u062f \u0648 \u0628\u0631\u0627\u06cc \u06a9\u0645\u06a9 \u0628\u0647 \u0641\u0647\u0645 \u0628\u0647\u062a\u0631 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u0646\u062f.\nuser: \u0627\u0646\u0648\u0627\u0639 \u0634\u0645\u0627\u0631\u0647 \u0633\u0646\u062f \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc\nassistant: \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc\u060c \u0634\u0645\u0627\u0631\u0647 \u0633\u0646\u062f \u0628\u0647 \u0686\u0646\u062f\u06cc\u0646 \u0646\u0648\u0639 \u0645\u062e\u062a\u0644\u0641 \u062a\u0642\u0633\u06cc\u0645 \u0645\u06cc\u200c\u0634\u0648\u062f:\n\n1. \u0634\u0645\u0627\u0631\u0647 \u0641\u0631\u0639\u06cc: \u0627\u06cc\u0646 \u06cc\u06a9 \u0641\u06cc\u0644\u062f \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0627\u0633\u062a \u06a9\u0647 \u062a\u0648\u0633\u0637 \u0634\u0631\u06a9\u062a \u0647\u0627 \u0628\u0631\u0627\u06cc \u062f\u0644\u0627\u06cc\u0644 \u0645\u062e\u062a\u0644\u0641 \u0645\u062b\u0644 \u0628\u0627\u06cc\u06af\u0627\u0646\u06cc \u067e\u0631 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0633\u06cc\u0633\u062a\u0645 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u06cc\u06a9\u062a\u0627 \u0628\u0648\u062f\u0646 \u0627\u06cc\u0646 \u0634\u0645\u0627\u0631\u0647 \u0631\u0627 \u062f\u0631 \u0633\u0637\u062d \u0634\u0631\u06a9\u062a \u06cc\u0627 \u0634\u0639\u0628\u0647 \u06a9\u0646\u062a\u0631\u0644 \u06a9\u0646\u062f.\n\n2. \u0634\u0645\u0627\u0631\u0647 \u0631\u0648\u0632\u0627\u0646\u0647: \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062f \u0646\u0634\u0627\u0646 \u062f\u0647\u0646\u062f\u0647 \u062a\u0631\u062a\u06cc\u0628 \u0627\u06cc\u062c\u0627\u062f \u0627\u0633\u0646\u0627\u062f \u062f\u0631 \u0647\u0631 \u0631\u0648\u0632 \u0627\u0633\u062a. \u0627\u06cc\u0646 \u0634\u0645\u0627\u0631\u0647 \u062a\u0648\u0633\u0637 \u0633\u06cc\u0633\u062a\u0645 \u062b\u0628\u062a \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0642\u0627\u0628\u0644 \u0648\u06cc\u0631\u0627\u06cc\u0634 \u0646\u06cc\u0633\u062a.\n\n3. \u0628\u0631\u0627\u06cc \u062a\u0631\u06a9\u06cc\u0628 \u06a9\u0645\u067e\u0627\u0646\u06cc + \u062f\u0641\u062a\u0631 + \u0633\u0627\u0644 \u0645\u0627\u0644\u06cc\u060c \u0634\u0645\u0627\u0631\u0647 \u0633\u0646\u062f \u0628\u0627 \u0634\u0631\u0648\u0639 \u0627\u0632 1 \u062a\u0648\u0633\u0637 \u0633\u06cc\u0633\u062a\u0645 \u062a\u0639\u06cc\u06cc\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u062f\u0631 \u0633\u0637\u062d \u0627\u06cc\u0646 \u062a\u0631\u06a9\u06cc\u0628 \u06cc\u06a9\u062a\u0627 \u0627\u0633\u062a.\n\n4. \u0627\u06af\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u062f\u0641\u062a\u0631 \u06a9\u0644 \u0634\u0645\u0627\u0631\u0647 \u06af\u0630\u0627\u0631\u06cc \u0627\u0633\u0646\u0627\u062f \u0631\u0627 \u0628\u0631\u0627\u0633\u0627\u0633 \u0634\u0639\u0628\u0647 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u062f\u060c \u0628\u0631\u0627\u06cc \u062a\u0631\u06a9\u06cc\u0628 \u06a9\u0645\u067e\u0627\u0646\u06cc + \u062f\u0641\u062a\u0631 + \u0633\u0627\u0644 \u0645\u0627\u0644\u06cc + \u0634\u0639\u0628\u0647\u060c \u0634\u0645\u0627\u0631\u0647 \u0633\u0646\u062f \u0628\u0627 \u0634\u0631\u0648\u0639 \u0627\u0632 1 \u062a\u0639\u06cc\u06cc\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u062f\u0631 \u0633\u0637\u062d \u0627\u06cc\u0646 \u062a\u0631\u06a9\u06cc\u0628 \u06cc\u06a9\u062a\u0627 \u0627\u0633\u062a.", "timestamp": "2024-07-22T10:26:20.291701+00:00"}
{"asctime": "2024-07-22 10:27:12,460", "levelname": "INFO", "message": "call llm", "session": "0afeae5f-dda5-42d8-9e80-5fb60e8227a7", "question": "\u0686\u0637\u0648\u0631 \u062f\u0648 \u0642\u0644\u0645 \u0633\u0646\u062f \u0631\u0648 \u062c\u0627 \u0628 \u062c\u0627 \u06a9\u0646\u0645\u061f", "answer": "\u0628\u0631\u0627\u06cc \u062c\u0627\u0628\u062c\u0627 \u06a9\u0631\u062f\u0646 \u0627\u0642\u0644\u0627\u0645 \u0633\u0646\u062f\u060c \u0645\u0639\u0645\u0648\u0644\u0627\u064b \u0628\u0633\u062a\u06af\u06cc \u0628\u0647 \u0628\u0631\u0646\u0627\u0645\u0647 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u06cc\u0627 \u0633\u06cc\u0633\u062a\u0645\u06cc \u06a9\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f \u062f\u0627\u0631\u062f. \u062f\u0631 \u0628\u0631\u062e\u06cc \u0633\u06cc\u0633\u062a\u0645\u200c\u0647\u0627\u060c \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0631\u0648\u06cc \u0642\u0644\u0645 \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u06a9\u0644\u06cc\u06a9 \u06a9\u0631\u062f\u0647 \u0648 \u0622\u0646 \u0631\u0627 \u0628\u0647 \u062c\u0627\u06cc \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u062e\u0648\u062f \u0628\u06a9\u0634\u06cc\u062f. \u062f\u0631 \u0628\u0631\u062e\u06cc \u0633\u06cc\u0633\u062a\u0645\u200c\u0647\u0627\u06cc \u062f\u06cc\u06af\u0631\u060c \u0634\u0645\u0627 \u0628\u0627\u06cc\u062f \u0627\u0628\u062a\u062f\u0627 \u0642\u0644\u0645 \u0631\u0627 \u062d\u0630\u0641 \u06a9\u0631\u062f\u0647 \u0648 \u0628\u0639\u062f \u062f\u0648\u0628\u0627\u0631\u0647 \u062f\u0631 \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u0648\u0631\u062f \u0646\u0638\u0631 \u062b\u0628\u062a \u06a9\u0646\u06cc\u062f.\n\n\u0627\u0645\u0627 \u0644\u0637\u0641\u0627\u064b \u062a\u0648\u062c\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u0647\u0645\u06cc\u0634\u0647 \u0642\u0628\u0644 \u0627\u0632 \u0627\u06cc\u0646\u06a9\u0647 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a\u06cc \u0628\u06cc\u0627\u0648\u0631\u06cc\u062f\u060c \u0628\u0647\u062a\u0631 \u0627\u0633\u062a \u06cc\u06a9 \u0628\u0627\u0631 \u062f\u06cc\u06af\u0631 \u0633\u0646\u062f \u0631\u0627 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f \u0648 \u0645\u0637\u0645\u0626\u0646 \u0634\u0648\u06cc\u062f \u06a9\u0647 \u062a\u063a\u06cc\u06cc\u0631 \u0642\u0631\u0627\u0631\u062f\u0627\u062f\u0646 \u0627\u0642\u0644\u0627\u0645 \u0633\u0646\u062f \u062a\u0627\u062b\u06cc\u0631 \u0645\u0646\u0641\u06cc \u0631\u0648\u06cc \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u06cc\u0627 \u0641\u0631\u0622\u06cc\u0646\u062f\u0647\u0627\u06cc \u0645\u0631\u062a\u0628\u0637 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a.", "context": "\u062c\u0627\u0628\u0647 \u062c\u0627\u06cc\u06cc \u0628\u062f\u0647\u06a9\u0627\u0631 \u0648 \u0628\u0633\u062a\u0627\u0646\u06a9\u0627\u0631: \u0645\u0628\u0644\u063a \u0628\u062f\u0647\u06a9\u0627\u0631 \u06cc\u0627 \u0628\u0633\u062a\u0627\u0646\u06a9\u0627\u0631 \u062b\u0628\u062a \u0634\u062f\u0647 \u062f\u0631 \u0642\u0644\u0645 \u0633\u0646\u062f \u062c\u0627 \u0628\u0647 \u062c\u0627 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.\n\u06a9\u067e\u06cc: \u0642\u0644\u0645 \u06cc\u0627 \u0627\u0642\u0644\u0627\u0645 \u0627\u0646\u062a\u062e\u0627\u0628\u06cc \u0628\u0647 \u0635\u0648\u0631\u062a \u06a9\u0627\u0645\u0644 \u06a9\u067e\u06cc \u0634\u062f\u0647 \u0648 \u0627\u0645\u06a9\u0627\u0646 \u0686\u0633\u0628\u0627\u0646\u062f\u0646 \u062f\u0631 \u0647\u0645\u06cc\u0646 \u0633\u0646\u062f \u06cc\u0627 \u06cc\u06a9 \u0633\u0646\u062f \u062f\u06cc\u06af\u0631 \u0648\u062c\u0648\u062f \u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a.\n\u062d\u0630\u0641: \u0642\u0644\u0645 \u06cc\u0627 \u0627\u0642\u0644\u0627\u0645 \u0627\u0646\u062a\u062e\u0627\u0628\u06cc \u062d\u0630\u0641 \u0645\u06cc\u0634\u0648\u0646\u062f.\n\u067e\u0633 \u0627\u0632 \u062b\u0628\u062a \u0633\u0646\u062f \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0644\u06cc\u062f \u0630\u062e\u06cc\u0631\u0647\u060c \u0633\u0646\u062f \u0634\u0645\u0627 \u0628\u0627 \u0648\u0636\u0639\u06cc\u062a \u0645\u0648\u0642\u062a \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u062b\u0628\u062a \u0645\u06cc\u0634\u0648\u062f.\n\u2022 \u062f\u0631 \u0635\u0648\u0631\u062a \u0627\u0646\u062a\u062e\u0627\u0628 \u0630\u062e\u06cc\u0631\u0647 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a\u060c \u0648\u0636\u0639\u06cc\u062a \u0633\u0646\u062f \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0634\u062f\u0647 \u0648 \u062f\u0631 \u06af\u0632\u0627\u0631\u0634\u0627\u062a \u0622\u062b\u0627\u0631 \u0627\u0633\u0646\u0627\u062f \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0645\u0634\u0627\u0647\u062f\u0647 \u0646\u062e\u0648\u0627\u0647\u062f \u0634\u062f.\n\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0642\u0644\u0645 \u0633\u0646\u062f \u0627\u0646\u0628\u0627\u0631 \u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0627\u0644\u0627 \u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0622\u0646 \u06a9\u0627\u0644\u0627 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc \u0634\u0648\u062f. \u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u0627\u0646\u062a\u062e\u0627\u0628 \u0634\u062f\u0647\u060c \u0645\u0642\u062f\u0627\u0631 \u06a9\u0627\u0644\u0627 \u0648\u0627\u0631\u062f \u0645\u06cc \u0634\u0648\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u06a9\u0647 \u06a9\u0627\u0644\u0627 \u062f\u0627\u0631\u0627\u06cc \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u062f\u0648\u0645 \u0628\u0627\u0634\u062f\u060c \u0645\u0642\u062f\u0627\u0631 \u0628\u0647 \u0648\u0627\u062d\u062f \u0633\u0646\u062c\u0634 \u062f\u0648\u0645 \u0646\u06cc\u0632 \u0644\u0627\u0632\u0645 \u0627\u0633\u062a \u0645\u0642\u062f\u0627\u0631\u062f\u0647\u06cc \u06af\u0631\u062f\u062f.\n\u0645\u0648\u0627\u0632\u0646\u0647 \u0645\u0628\u0644\u063a: \n\u0628\u0627 \u0627\u06cc\u0646 \u0627\u06a9\u0634\u0646 \u0646\u06cc\u0627\u0632\u06cc \u0628\u0647 \u062b\u0628\u062a \u0645\u0628\u0644\u063a \u062f\u0631 \u0642\u0644\u0645 \u0646\u062f\u0627\u0631\u06cc\u062f \u0648 \u0633\u06cc\u0633\u062a\u0645 \u0645\u0628\u0627\u0644\u063a \u0633\u0627\u06cc\u0631 \u0631\u062f\u06cc\u0641 \u0647\u0627 \u0631\u0627 \u0645\u062d\u0627\u0633\u0628\u0647 \u0648 \u0645\u0628\u0644\u063a\u06cc \u06a9\u0647 \u0628\u0627\u0639\u062b \u0645\u0648\u0627\u0632\u0646\u0647 \u0633\u0646\u062f \u0645\u06cc \u0634\u0648\u062f \u0631\u0627 \u062f\u0631 \u0631\u062f\u06cc\u0641 \u062c\u0627\u0631\u06cc \u062b\u0628\u062a \u0645\u06cc \u06a9\u0646\u062f.\n\u0633\u06cc\u0633\u062a\u0645 \u0628\u0627 \u062c\u0645\u0639 \u0645\u0628\u0644\u063a \u0631\u062f\u06cc\u0641 \u0647\u0627\u06cc \u062b\u0628\u062a \u0634\u062f\u0647 \u0648 \u06a9\u0645 \u06a9\u0631\u062f\u0646 \u0633\u0631\u062c\u0645\u0639 \u0628\u062f\u0647\u06a9\u0627\u0631 \u0627\u0632 \u0633\u0631\u062c\u0645\u0639 \u0628\u0633\u062a\u0627\u0646\u06a9\u0627\u0631 \u0628\u0631\u0627\u06cc \u0642\u0644\u0645 \u0647\u0627\u06cc\u06cc \u06a9\u0647 \u062a\u0627\u06a9\u0646\u0648\u0646 \u062b\u0628\u062a \u0634\u062f\u0647 \u0627\u0633\u062a \u060c \u0645\u0628\u0644\u063a \u0645\u0648\u0627\u0632\u0646\u0647 \u0631\u0627 \u062a\u0634\u062e\u06cc\u0635 \u0645\u06cc \u062f\u0647\u062f .\n\u0627\u06af\u0631 \u0645\u0627\u0646\u062f\u0647 \u0645\u062d\u0627\u0633\u0628\u0647 \u0635\u0641\u0631 \u0628\u0627\u0634\u062f \u060c \u0628\u0647 \u06a9\u0627\u0631\u0628\u0631 \u067e\u06cc\u063a\u0627\u0645 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f \u06a9\u0647 \u0628\u062f\u0648\u0646 \u062b\u0628\u062a \u0642\u0644\u0645 \u0645\u0648\u0627\u0632\u0646\u0647 \u060c \u0633\u0646\u062f \u0628\u0627\u0644\u0627\u0646\u0633 \u0627\u0633\u062a .\n\u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06cc\u06a9\u06cc \u0627\u0632 \u0627\u0642\u0644\u0627\u0645 \u0633\u0646\u062f\u060c \u0627\u06a9\u0634\u0646 \u0647\u0627\u06cc \u0632\u06cc\u0631 \u0628\u0647 \u0634\u0645\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f:\n\u0627\u0642\u0644\u0627\u0645 \u0633\u0646\u062f\n\u067e\u0633 \u0627\u0632 \u0648\u0631\u0648\u062f \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0627\u062c\u0628\u0627\u0631\u06cc \u062f\u0631 \u0628\u062e\u0634 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0633\u0646\u062f\u060c \u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0644\u06cc\u062f \"\u062c\u062f\u06cc\u062f\"\u060c \u06cc\u06a9 \u0642\u0644\u0645 \u0633\u0646\u062f \u0627\u06cc\u062c\u0627\u062f \u0634\u062f\u0647 \u0648 \u0627\u0645\u06a9\u0627\u0646 \u0648\u0631\u0648\u062f \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0628\u0631\u0627\u06cc \u0634\u0645\u0627 \u0628\u0647 \u0634\u0631\u062d \u0632\u06cc\u0631 \u0648\u062c\u0648\u062f \u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a:\n\u062f\u0631 \u0635\u0648\u0631\u062a\u06cc \u06a9\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062a\u06a9\u0645\u06cc\u0644\u06cc  \u0631\u0633\u06cc\u062f \u062e\u0631\u06cc\u062f \u062f\u0627\u062e\u0644\u06cc \u0628\u0631\u0627\u06cc \u062b\u0628\u062a \u062f\u0631 \u0642\u0644\u0645 \u062a\u0646\u0638\u06cc\u0645 \u0634\u062f\u0647 \u0628\u0627\u0634\u062f \u060c \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062f\u0647\u0627 \u0628\u0631\u0627\u06cc \u0645\u0642\u062f\u0627\u0631\u062f\u0647\u06cc \u062f\u0631 \u0642\u0644\u0645 \u0633\u0646\u062f \u0627\u0646\u0628\u0627\u0631 \u0646\u06cc\u0632 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f. \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062f\u0647\u0627 \u0639\u0628\u0627\u0631\u062a\u0646\u062f \u0627\u0632: \u0634\u0645\u0627\u0631\u0647 \u0633\u0641\u0627\u0631\u0634 \u062e\u0631\u06cc\u062f\u060c \u0634\u0645\u0627\u0631\u0647 \u0641\u0627\u06a9\u062a\u0648\u0631 \u062e\u0631\u06cc\u062f\u060c \u062a\u062d\u0648\u06cc\u0644 \u06af\u06cc\u0631\u0646\u062f\u0647\u060c \u0634\u06a9\u0627\u0631\u0647 \u0628\u0627\u0632\u0631\u0633\u06cc \u06a9\u06cc\u0641\u06cc\u062a\u060c \u0634\u0645\u0627\u0631\u0647 \u0686\u06a9 \u0644\u06cc\u0633\u062a\u060c \u0634\u0645\u0627\u0631\u0647 \u0622\u0632\u0645\u0627\u06cc\u0634\u06af\u0627\u0647\u060c \u062a\u0627\u06cc\u06cc\u062f \u0627\u0631\u0641\u0627\u0642\u06cc\u060c \u0646\u062a\u06cc\u062c\u0647 \u0628\u0627\u0632\u0631\u0633\u06cc\u060c \u0634\u0645\u0627\u0631\u0647 COA\u060c \u0646\u0627\u0645 \u0631\u0627\u0646\u0646\u062f\u0647\u060c \u0646\u0627\u0645 \u062e\u0648\u062f\u0631\u0648\u060c \u0634\u0645\u0627\u0631\u0647 \u067e\u0644\u0627\u06a9\u060c \u0634\u0645\u0627\u0631\u0647 \u0628\u0627\u0631\u0646\u0627\u0645\u0647\u060c \u062a\u0627\u0631\u06cc\u062e \u0628\u0627\u0631\u0646\u0627\u0645\u0647\u060c \u0634\u0645\u0627\u0631\u0647 \u0631\u0627\u0646\u0646\u062f\u0647.\n  \u062f\u0631 \u0628\u062e\u0634 \u0633\u0627\u06cc\u062f\u0628\u0627\u0631 \u0633\u0646\u062f \u0627\u0646\u0628\u0627\u0631 \u062c\u0645\u0639 \u06a9\u0644 \u0627\u0642\u0644\u0627\u0645 \u0633\u0646\u062f \u0628\u0647 \u0648\u0627\u062d\u062f\u0647\u0627\u06cc \u062b\u0628\u062a \u0633\u0646\u062f\u060c \u0648\u0627\u062d\u062f \u0627\u0635\u0644\u06cc \u0648 \u0648\u0627\u062d\u062f \u062f\u0648\u0645 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f.", "history": "user: \u0633\u0646\u062f \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0686\u06cc\u0647\nassistant: \u0633\u0646\u062f \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u062f\u0631 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0645\u0639\u0645\u0648\u0644\u0627\u064b \u0628\u0631\u0627\u06cc \u062b\u0628\u062a \u062a\u0648\u0636\u06cc\u062d\u0627\u062a\u060c \u062c\u0632\u0626\u06cc\u0627\u062a \u0627\u0636\u0627\u0641\u06cc \u06cc\u0627 \u0646\u06a9\u0627\u062a \u0645\u0647\u0645 \u062f\u0631\u0628\u0627\u0631\u0647 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u062f. \u0627\u06cc\u0646 \u0633\u0646\u062f \u0647\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0634\u0627\u0645\u0644 \u062a\u0648\u0636\u06cc\u062d\u0627\u062a \u062f\u0631\u0628\u0627\u0631\u0647 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc\u060c \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0642\u06cc\u0645\u062a\u060c \u062a\u062e\u0641\u06cc\u0641\u0627\u062a \u0648 \u063a\u06cc\u0631\u0647 \u0628\u0627\u0634\u0646\u062f. \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u0647\u0627 \u0645\u0639\u0645\u0648\u0644\u0627\u064b \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0633\u0646\u062f \u0647\u0627\u06cc \u0645\u0627\u0644\u06cc \u06cc\u06a9 \u0634\u0631\u06a9\u062a \u062f\u0631 \u0646\u0638\u0631 \u06af\u0631\u0641\u062a\u0647 \u0645\u06cc \u0634\u0648\u0646\u062f \u0648 \u0628\u0631\u0627\u06cc \u06a9\u0645\u06a9 \u0628\u0647 \u0641\u0647\u0645 \u0628\u0647\u062a\u0631 \u0645\u0639\u0627\u0645\u0644\u0627\u062a \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc \u0634\u0648\u0646\u062f.\nuser: \u0627\u0646\u0648\u0627\u0639 \u0634\u0645\u0627\u0631\u0647 \u0633\u0646\u062f \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc\nassistant: \u062f\u0631 \u0633\u06cc\u0633\u062a\u0645 \u062d\u0633\u0627\u0628\u062f\u0627\u0631\u06cc\u060c \u0634\u0645\u0627\u0631\u0647 \u0633\u0646\u062f \u0628\u0647 \u0686\u0646\u062f\u06cc\u0646 \u0646\u0648\u0639 \u0645\u062e\u062a\u0644\u0641 \u062a\u0642\u0633\u06cc\u0645 \u0645\u06cc\u200c\u0634\u0648\u062f:\n\n1. \u0634\u0645\u0627\u0631\u0647 \u0641\u0631\u0639\u06cc: \u0627\u06cc\u0646 \u06cc\u06a9 \u0641\u06cc\u0644\u062f \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0627\u0633\u062a \u06a9\u0647 \u062a\u0648\u0633\u0637 \u0634\u0631\u06a9\u062a \u0647\u0627 \u0628\u0631\u0627\u06cc \u062f\u0644\u0627\u06cc\u0644 \u0645\u062e\u062a\u0644\u0641 \u0645\u062b\u0644 \u0628\u0627\u06cc\u06af\u0627\u0646\u06cc \u067e\u0631 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0633\u06cc\u0633\u062a\u0645 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u06cc\u06a9\u062a\u0627 \u0628\u0648\u062f\u0646 \u0627\u06cc\u0646 \u0634\u0645\u0627\u0631\u0647 \u0631\u0627 \u062f\u0631 \u0633\u0637\u062d \u0634\u0631\u06a9\u062a \u06cc\u0627 \u0634\u0639\u0628\u0647 \u06a9\u0646\u062a\u0631\u0644 \u06a9\u0646\u062f.\n\n2. \u0634\u0645\u0627\u0631\u0647 \u0631\u0648\u0632\u0627\u0646\u0647: \u0627\u06cc\u0646 \u0641\u06cc\u0644\u062f \u0646\u0634\u0627\u0646 \u062f\u0647\u0646\u062f\u0647 \u062a\u0631\u062a\u06cc\u0628 \u0627\u06cc\u062c\u0627\u062f \u0627\u0633\u0646\u0627\u062f \u062f\u0631 \u0647\u0631 \u0631\u0648\u0632 \u0627\u0633\u062a. \u0627\u06cc\u0646 \u0634\u0645\u0627\u0631\u0647 \u062a\u0648\u0633\u0637 \u0633\u06cc\u0633\u062a\u0645 \u062b\u0628\u062a \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0642\u0627\u0628\u0644 \u0648\u06cc\u0631\u0627\u06cc\u0634 \u0646\u06cc\u0633\u062a.\n\n3. \u0628\u0631\u0627\u06cc \u062a\u0631\u06a9\u06cc\u0628 \u06a9\u0645\u067e\u0627\u0646\u06cc + \u062f\u0641\u062a\u0631 + \u0633\u0627\u0644 \u0645\u0627\u0644\u06cc\u060c \u0634\u0645\u0627\u0631\u0647 \u0633\u0646\u062f \u0628\u0627 \u0634\u0631\u0648\u0639 \u0627\u0632 1 \u062a\u0648\u0633\u0637 \u0633\u06cc\u0633\u062a\u0645 \u062a\u0639\u06cc\u06cc\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u062f\u0631 \u0633\u0637\u062d \u0627\u06cc\u0646 \u062a\u0631\u06a9\u06cc\u0628 \u06cc\u06a9\u062a\u0627 \u0627\u0633\u062a.\n\n4. \u0627\u06af\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u062f\u0641\u062a\u0631 \u06a9\u0644 \u0634\u0645\u0627\u0631\u0647 \u06af\u0630\u0627\u0631\u06cc \u0627\u0633\u0646\u0627\u062f \u0631\u0627 \u0628\u0631\u0627\u0633\u0627\u0633 \u0634\u0639\u0628\u0647 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u062f\u060c \u0628\u0